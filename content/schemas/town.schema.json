{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "town.schema.json",
  "title": "Town layout",
  "description": "Authoritative town definition. The server owns this; the client assembles a scene from it but never authors it. See docs/ARCHITECTURE.md §1. Version 2 adds the fields the Hearthmere rebuild needs: a terrain height contract, a numbered building-slot schedule, the wall ring, the water bodies and the authored sightlines. Generated by tools/plan/townplan.py from tools/plan/plan_data.py — do not hand-edit.",
  "type": "object",
  "required": ["id", "grid", "venues", "playerSpawn"],
  "properties": {
    "id":          { "type": "string" },
    "displayName": { "type": "string" },
    "zonePrefix":  { "type": "string", "description": "Prefix for all entity IDs in this zone." },
    "version":     { "type": "integer", "description": "2 = the walled 192 m town with the church arrival." },
    "description": { "type": "string" },

    "grid": {
      "type": "object",
      "required": ["cellSize"],
      "properties": {
        "cellSize": { "type": "number", "description": "16 m. Chosen so a 3-cell radius (48 m) exceeds the ~40 m detail horizon." },
        "cols":     { "type": "array" },
        "rows":     { "type": "array" },
        "originCell": { "type": "string" },
        "bounds": {
          "type": "object",
          "properties": {
            "min": { "type": "array", "minItems": 2, "maxItems": 2 },
            "max": { "type": "array", "minItems": 2, "maxItems": 2 }
          }
        },
        "comment": { "type": "string" }
      }
    },

    "lighting": { "type": "object", "description": "Locked at 09:30 per Art Bible §4. Authoritative copy — see D-009." },

    "terrain": {
      "type": "object",
      "description": "A POINTER, not a model. content/town/terrain.json is the ground (D-022, D-024); this block records the datum and the named levels the plan is dimensioned from. There is no height model here and there must never be one again — the last one disagreed with the real ground by up to 1.48 m.",
      "required": ["spotLevels"],
      "properties": {
        "source":  { "const": "content/town/terrain.json" },
        "datum":   { "type": "string" },
        "comment": { "type": ["string", "array"] },
        "spotLevels": {
          "type": "array",
          "description": "Named levels. `source: terrain` means the value was read from the height field and is not authored anywhere; `source: made` means a building owns it and townplan.py --check asserts it stands on the ground.",
          "items": {
            "type": "object",
            "required": ["name", "pos", "y"],
            "properties": {
              "name": { "type": "string" },
              "pos":  { "type": "array", "minItems": 2, "maxItems": 2 },
              "y":    { "type": "number" },
              "kind": { "enum": ["paving", "made", "floor", "deck", "step", "water"] },
              "source": { "enum": ["terrain", "made"] }
            }
          }
        }
      }
    },

    "playerSpawn": {
      "type": "object",
      "required": ["pos"],
      "properties": {
        "pos":       { "type": "array", "minItems": 3, "maxItems": 3 },
        "facingDeg": { "type": "number", "description": "forward = (sin, 0, -cos). 0 = north (-Z), 90 = east, 180 = south, 270 = west." },
        "comment":   { "type": "string" }
      }
    },

    "districts": {
      "type": "array",
      "description": "Why each quarter is where it is. Prose, but load-bearing prose: a builder placing residue reads it.",
      "items": {
        "type": "object",
        "required": ["id", "name", "cause"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "cells": { "type": "string" }, "cause": { "type": "string" },
          "holds": { "type": "string" }
        }
      }
    },

    "venues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "origin"],
        "properties": {
          "id":          { "type": "string", "description": "Matches a module NAME in tools/assetgen/venues/." },
          "instance":    { "type": "string", "description": "Set when a venue is placed more than once." },
          "slot":        { "type": "integer", "description": "Row in buildingSlots[] that owns this venue's footprint." },
          "cells":       { "type": "array", "items": { "type": "string" } },
          "origin":      { "type": "array", "minItems": 3, "maxItems": 3, "description": "y is the ground level from terrain, never 0 by default." },
          "rotationDeg": { "type": "number" },
          "role":        { "type": "string" },
          "variant":     { "type": "integer" },
          "comment":     { "type": "string" }
        }
      }
    },

    "buildingSlots": {
      "type": "array",
      "description": "The numbered schedule of every discrete building mass. A builder agent is handed one row and must be able to build from it without asking a question.",
      "items": {
        "type": "object",
        "required": ["n", "id", "kit", "centre", "footprint", "polygon", "rotationDeg"],
        "properties": {
          "n":            { "type": "integer" },
          "id":           { "type": "string" },
          "kit":          { "type": "string", "description": "Venue module or kit family that builds this mass." },
          "venue":        { "type": ["string", "null"] },
          "role":         { "enum": ["hero", "secondary", "filler"] },
          "cells":        { "type": "array", "items": { "type": "string" } },
          "centre":       { "type": "array", "minItems": 2, "maxItems": 2 },
          "footprint":    { "type": "object", "properties": { "w": { "type": "number" }, "d": { "type": "number" } } },
          "polygon":      { "type": "array", "minItems": 4, "maxItems": 4 },
          "rotationDeg":  { "type": "number", "description": "Direction the principal facade faces." },
          "storeys":      { "type": "integer" },
          "eavesHeight":  { "type": "number" },
          "ridge":        { "enum": ["along", "gable", "flat", "cone"] },
          "groundY":      { "type": "number" },
          "outsideWall":  { "type": "boolean" },
          "fronts":       { "type": "string" },
          "note":         { "type": "string" },
          "facadeBreak":  { "type": "string", "description": "How a street face longer than 12 m is broken (Art Bible section 7). Authored in tools/plan/plan_data.py BREAKS; required by the checker for every face over the cap." }
        }
      }
    },

    "streets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "width", "path"],
        "properties": {
          "id":      { "type": "string" },
          "name":    { "type": "string" },
          "width":   { "type": "number", "description": "Kerb to kerb." },
          "verge":   { "type": "number", "description": "Footway wanted between kerb and building line." },
          "surface": { "type": "string" },
          "cls":     { "enum": ["primary", "secondary", "lane", "alley", "steps"] },
          "outside": { "type": "boolean", "description": "Runs outside the wall." },
          "note":    { "type": "string" },
          "bridged": { "type": "array", "minItems": 2, "maxItems": 2, "description": "z interval carried on a bridge, and therefore allowed to be over water." },
          "path":    { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 }, "description": "[x, z] carriageway centreline. NO Y: take the level from terrain.height(x, z). D-024." }
        }
      }
    },

    "wall": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "comment":       { "type": "string" },
        "path":          { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 }, "description": "[x, z]; level from terrain." },
        "walkHeight":    { "type": "number" },
        "parapet":       { "type": "number" },
        "thicknessBase": { "type": "number" },
        "nearWater":     { "type": "array", "description": "The two points between which the wall runs along the mere, with only the berm and Tan Road between its face and the water." },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pos", "kind"],
            "properties": {
              "id": { "type": "string" }, "name": { "type": "string" },
              "kind": { "enum": ["gate", "postern", "water"] },
              "pos": { "type": "array", "minItems": 2, "maxItems": 2 },
              "rot": { "type": "number" }, "clear": { "type": "number" },
              "head": { "type": "number" }, "note": { "type": "string" }
            }
          }
        },
        "towers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pos"],
            "properties": {
              "id": { "type": "string" }, "name": { "type": "string" },
              "pos": { "type": "array", "minItems": 2, "maxItems": 2 },
              "shape": { "enum": ["round", "square"] },
              "height": { "type": "number" }
            }
          }
        },
        "stairs": { "type": "array", "description": "Mural stairs up to the wall-walk." }
      }
    },

    "water": {
      "type": "object",
      "description": "A POINTER. The water bodies are shapes in content/town/terrain.json's water.channels, because the water IS the ground. This block names them and carries the wharf outline, which is layout rather than hydrology.",
      "properties": {
        "source":   { "const": "content/town/terrain.json" },
        "comment":  { "type": "string" },
        "surfaceY": { "type": "number", "description": "One elevation for the whole system. Mirrors terrain.json water.level." },
        "bodies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id":   { "type": "string" },
              "name": { "type": ["string", "null"] },
              "kind": { "enum": ["channel", "basin"] }
            }
          }
        },
        "wharf": { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 } }
      }
    },

    "marketPlace": {
      "type": "object",
      "properties": {
        "polygon": { "type": "array" },
        "step":    { "type": "object" }
      }
    },

    "openLots": {
      "type": "array",
      "description": "Unroofed lots. They are not building masses and do not count toward the 75-95 target, but half the town's life is in them.",
      "items": {
        "type": "object",
        "required": ["id", "poly"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "kind": { "type": "string" }, "poly": { "type": "array" },
          "note": { "type": "string" }
        }
      }
    },

    "landmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "pos"],
        "properties": {
          "id":      { "type": "string" }, "name": { "type": "string" },
          "pos":     { "type": "array", "minItems": 2, "maxItems": 2, "description": "[x, z]." },
          "groundY": { "type": "number", "description": "Convenience copy of terrain.height(x, z); terrain is authoritative." },
          "comment": { "type": "string" }
        }
      }
    },

    "sightlines": {
      "type": "array",
      "description": "Compositions the build is judged on. tools/plan/townplan.py --check proves the arrival frame geometrically.",
      "items": {
        "type": "object",
        "required": ["id", "eye"],
        "properties": {
          "id": { "type": "string" }, "name": { "type": "string" },
          "eye": { "type": "array", "minItems": 3, "maxItems": 3 },
          "facingDeg": { "type": "number" },
          "aperture": { "type": "object" },
          "mustBeVisible": { "type": "array" },
          "comment": { "type": "string" }
        }
      }
    },

    "ambient": { "type": "object" }
  }
}
